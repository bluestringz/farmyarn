# Copy this file to .env and fill in real values before starting the server.

# Random long secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on
PORT=3000

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/farmco-op.db

# Comma-free single origin (or * for any) allowed to call the API / connect via websocket.
# In production, set this to your actual domain, e.g. https://myfarmgame.com
CORS_ORIGIN=*
